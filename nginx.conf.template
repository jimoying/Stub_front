# Stub 前端 nginx 配置模板
# 官方 nginx 镜像启动时对本文件做 envsubst (仅替换已定义的环境变量),
# 输出 /etc/nginx/conf.d/default.conf。$uri / $host 等 nginx 内置变量不受影响。
# 必须显式传入: API_UPSTREAM=http://<后端>:8588
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vite 带内容哈希的静态资源: 一年强缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 根级图标等静态文件: 短缓存
    location = /favicon.svg {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA 路由回退 (React Router browser 路由)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # API 反代: 与 Vite dev proxy 的 /api -> target 语义对齐, 不改写路径
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # 上游入口按 Host 分流, 必须改写为上游域名 (等价 Vite changeOrigin), 原始域名放 X-Forwarded-Host
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        # 后端 CORS 白名单不含本容器访问域名, 服务器间转发无 CORS 概念, 去 Origin 避免被拒
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 公开短链跳转 /r/<code> 反代到后端
    location /r/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # 上游入口按 Host 分流, 必须改写为上游域名 (等价 Vite changeOrigin), 原始域名放 X-Forwarded-Host
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        # 后端 CORS 白名单不含本容器访问域名, 服务器间转发无 CORS 概念, 去 Origin 避免被拒
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}