# 开发环境代理目标（对应 back/.env.example 中的 HTTP_PORT=8588 或 :8080）
#VITE_API_PROXY_TARGET=http://localhost:8588
VITE_API_PROXY_TARGET=https://stubapi.mikasa.wiki

# 若前端独立部署直连跨域 API，可配置完整后端地址（留空则默认同源 /api/v1）
VITE_API_BASE_URL=

# 公开短链访问域名展示前缀（仅用于输入框前缀展示，实际短链 URL 以服务端返回为准）
VITE_PUBLIC_BASE_URL=https://s.example.com
